{
  "name": "opencode-plan-canvas-plugin",
  "version": "0.2.1",
  "description": "Optional opencode plugin that auto-spawns (or nudges) an opencode-plan-canvas watch server when a plan or boulder file changes",
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": ["opencode", "opencode-plugin", "plugin", "plan", "canvas", "watch", "live-reload"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoispag/opencode-plan-canvas.git",
    "directory": "adapter/opencode-plugin"
  },
  "homepage": "https://github.com/zoispag/opencode-plan-canvas/tree/master/adapter/opencode-plugin#readme",
  "bugs": {
    "url": "https://github.com/zoispag/opencode-plan-canvas/issues"
  },
  "author": "zoispag",
  "license": "MIT",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@types/node": "^26.2.0"
  }
}
